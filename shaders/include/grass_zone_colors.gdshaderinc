// Shared grass color system — zone palettes + macro variation.
// All LOD tiers include this for color coherence across distances.
//
// Zone palettes: derived from spectral reflectance data via
//   R(λ) × CIE 1931 2° Observer × D65 Illuminant → XYZ → sRGB
// Values are effective albedo (leaf reflectance + transmittance).
// Generated by scripts/spectral_colors.py
//
// Macro variation: field-scale splotchiness from soil moisture, mowing
// timing, species mix, drainage, and foot traffic. This is the dominant
// visual signal at >5m — real grass fields are patchy, not uniform.
//
// Requires: hash_noise.gdshaderinc (vnoise, fbm3)

// Zone spectral palettes. Zone IDs are the pipeline encoding (docs/grass.md §2):
// 0=unzoned 1=garden 2=grass(named lawns) 3=pitch 4=playground 5=nature_reserve
// 6=dog_park 7=sports 8=pool 9=track 10=wood 11=forest 12=water 13=shore 14=wild_meadow
// Returns the low/high range for blade-group variation within each zone.
void grass_zone_palette(int zone_id, out vec3 c_lo, out vec3 c_hi) {
	if (zone_id == 0 || zone_id == 6) {
		// Unzoned fringes / dog park: Kentucky Bluegrass — less irrigated, drier
		c_lo = vec3(0.064, 0.172, 0.039);
		c_hi = vec3(0.088, 0.238, 0.054);
	} else if (zone_id == 1) {
		// Formal garden panels: Perennial Ryegrass (Lolium perenne) — manicured
		c_lo = vec3(0.051, 0.165, 0.032);
		c_hi = vec3(0.070, 0.228, 0.044);
	} else if (zone_id == 2) {
		// Named lawns (Sheep Meadow, Great Lawn, ...): Kentucky Bluegrass A/B-class
		c_lo = vec3(0.056, 0.171, 0.037);
		c_hi = vec3(0.078, 0.236, 0.051);
	} else if (zone_id == 3 || zone_id == 4 || zone_id == 7 || zone_id == 9) {
		// Pitch / playground / sports / track: KBG, heavy foot traffic
		c_lo = vec3(0.059, 0.171, 0.038);
		c_hi = vec3(0.082, 0.237, 0.052);
	} else if (zone_id == 5) {
		// nature_reserve (Hallett etc.): Fine Fescue — shade-tolerant.
		// Pushed darker + cooler so woodland reads distinctly vs lawn.
		c_lo = vec3(0.045, 0.110, 0.055);
		c_hi = vec3(0.062, 0.155, 0.078);
	} else if (zone_id == 10 || zone_id == 11) {
		// wood / forest: Fine Fescue — leaf-litter influence.
		// Same cool-dark palette as zone 5.
		c_lo = vec3(0.052, 0.115, 0.058);
		c_hi = vec3(0.072, 0.165, 0.082);
	} else if (zone_id == 13) {
		// shore (15m water dilation): Tussock Sedge (Carex stricta).
		// Cool/bluer so wetland reads as cool-saturated teal-green.
		c_lo = vec3(0.050, 0.155, 0.075);
		c_hi = vec3(0.072, 0.215, 0.108);
	} else if (zone_id == 14) {
		// wild_meadow (hand-marked D-class lawns): Switchgrass (Panicum
		// virgatum). Warmer + amber for prairie meadow look — distinctly
		// yellower than maintained lawn or cool wetland.
		c_lo = vec3(0.130, 0.185, 0.025);
		c_hi = vec3(0.180, 0.245, 0.035);
	} else {
		// Default (unhandled zones; grass shouldn't spawn on pool/water):
		// Kentucky Bluegrass.
		c_lo = vec3(0.056, 0.171, 0.037);
		c_hi = vec3(0.078, 0.236, 0.051);
	}
}

// Sedge tussock patchiness for the shore band (zone 13). Real sedge
// grows in clumps interleaved with bank grass — a uniform teal strip
// reads as a painted decal (walk-around defect #1, cpw_003). 0 = bank
// grass, 1 = full sedge. Shared by terrain + blade shaders so patches
// line up across tiers.
float sedge_patch_mask(vec2 world_xz) {
	float n = vnoise(world_xz / 4.5) * 0.65
	        + vnoise(world_xz / 1.3 + vec2(3.1, 17.7)) * 0.35;
	return smoothstep(0.30, 0.70, n);
}

// =====================================================================
// Unified mown-lawn sward color (2026-07-01). The near turf-tile blades
// (main.gd _make_turf_tile_mesh) look right — a rich blue-green KBG sward
// matching the sod reference photo. The mid shell grass and the distant
// terrain "felt" used to be colored from the darker/olive spectral zone
// palette below, so the lawn read as THREE bands (bright near blades →
// dark olive shell ring → pale yellow-olive far terrain) instead of one
// continuous field. This returns a single color whose MEAN matches the
// near blade palette's weighted average albedo (~0.168, 0.510, 0.176), so
// every layer is the same tint/brightness/character — only detail falls
// off with distance, exactly like the reference. The variation is kept
// SOFT (the reference field is near-uniform) so no new banding appears.
// =====================================================================
vec3 sward_grass_color(vec2 world_xz) {
	// Blade-group clump variation (3m). lo/hi bracket the near-blade mean.
	float micro = vnoise(world_xz / 3.0);
	vec3 lo = vec3(0.120, 0.400, 0.130);   // shaded / cooler clump
	vec3 hi = vec3(0.212, 0.612, 0.220);   // vigorous clump
	vec3 col = mix(lo, hi, micro);

	// Soft field-scale vitality drift — two rotated octaves so no axis
	// lattice. Deliberately gentle (±8%) so the field stays as uniform as
	// the reference; both ends stay green, never brown.
	vec2 r1 = mat2(vec2(0.80, -0.60), vec2(0.60, 0.80)) * world_xz;
	vec2 r2 = mat2(vec2(0.51, 0.86), vec2(-0.86, 0.51)) * world_xz;
	float macro = vnoise(r1 / 24.0 + vec2(13.7, 41.2)) * 0.6
	            + vnoise(r2 / 33.0 + vec2(7.1, 23.9)) * 0.4;
	col *= mix(0.93, 1.08, macro);

	// Faint warm/cool hue drift (8m) — stays in the green wedge, small.
	float hue = smoothstep(0.35, 0.65, vnoise(world_xz / 8.0 + vec2(51.3, 17.9)));
	col *= mix(vec3(1.03, 1.0, 0.95), vec3(0.95, 1.02, 1.0), hue);
	return col;
}

// Grass base color WITHOUT dead-tuft accents.
// The dead-tuft mask is fine-scale (~1.25m); on solid terrain it shows
// as scattered brown flecks under the camera. Blade-coverage shaders
// hide it naturally between blades, so they call the full
// grass_base_color() below. Terrain calls this one.
vec3 grass_base_color_no_dead(int zone_id, vec2 world_xz) {
	// Mown lawns (0,1,2,3,4,6,7,9) are the vast majority of park turf. They use
	// the UNIFIED sward color so the near turf-tile blades, the mid shell grass,
	// and the distant terrain felt are one continuous field (the reference look —
	// same tint/brightness at every distance). Non-lawn biomes (woodland, shore
	// sedge, wild meadow) keep their distinct spectral palettes below.
	if (zone_id == 0 || zone_id == 1 || zone_id == 2 || zone_id == 3
	 || zone_id == 4 || zone_id == 6 || zone_id == 7 || zone_id == 9) {
		return sward_grass_color(world_xz);
	}

	vec3 c_lo, c_hi;
	grass_zone_palette(zone_id, c_lo, c_hi);

	// --- Micro variation (3m) ---
	// Blade-group patchiness: small clumps of taller/shorter grass
	float micro = vnoise(world_xz / 3.0);
	vec3 col = mix(c_lo, c_hi, micro);

	// --- Macro variation (20-30m patches) ---
	// Soft field-scale tone drift from soil moisture, drainage, mowing
	// timing, species mix. CALIBRATED 2026-06-11 against Sheep Meadow
	// reference footage (notes/refs, hq_08-08): real mid-scale variation
	// is SOFT-edged and ±15-20% at most; the previous single-lattice
	// octave with smoothstep contrast boost and 0.72-1.50 range rendered
	// as a checkerboard of 2:1 axis-aligned blocks — that was the
	// comparison's "giant hard-edged diagonal line on the lawn" (finding
	// #2; cloud shadows were measured innocent via --diag-hide=cloudshadows).
	// Two ROTATED octaves break the lattice axis-alignment; no contrast
	// boost — raw vnoise is already the right softness.
	vec2 mrot1 = mat2(vec2(0.80, -0.60), vec2(0.60, 0.80)) * world_xz;  // ~37°
	vec2 mrot2 = mat2(vec2(0.51, 0.86), vec2(-0.86, 0.51)) * world_xz;  // ~-59°
	float macro = vnoise(mrot1 / 22.0 + vec2(13.7, 41.2)) * 0.6
	            + vnoise(mrot2 / 31.0 + vec2(7.1, 23.9)) * 0.4;
	// Range 0.85–1.18: stressed patches slightly darker/yellower,
	// vigorous slightly brighter/greener.
	float macro_scale = mix(0.85, 1.18, macro);
	col *= macro_scale;

	// Stressed patches lean warm (yellow-brown); vigorous lean cool (blue-green)
	// This hue shift correlates with the brightness — dry = yellow, lush = green
	float stress_hue = smoothstep(0.85, 1.12, macro_scale);
	col *= mix(vec3(1.07, 1.0, 0.88),   // stressed: warm/yellow
	           vec3(0.95, 1.0, 1.05),    // vigorous: cool/green
	           stress_hue);

	// --- Landscape gradient (70m) ---
	// Gentle tone drift across large fields — one end of Great Lawn
	// might be subtly different from the other
	float landscape = vnoise(world_xz / 70.0 + vec2(91.3, 7.7));
	col *= mix(0.96, 1.04, landscape);

	// --- Warm/cool hue drift (8m) ---
	// Independent of brightness — patches lean yellow-green vs blue-green.
	// Contrast-boosted like macro for visible effect.
	float hue_raw = vnoise(world_xz / 8.0 + vec2(51.3, 17.9));
	float hue = smoothstep(0.3, 0.7, hue_raw);
	col *= mix(vec3(1.06, 1.0, 0.88), vec3(0.92, 1.0, 1.10), hue);

	// Golden undertone — waxy cuticle + chlorophyll absorption
	col *= vec3(1.04, 1.01, 0.94);

	return col;
}

// =====================================================================
// Turf wear (docs/grass.md §4) — green-brown mottle + worn dirt.
// Reference: Sheep Meadow footage (notes/refs): mown turf is mottled
// green-brown everywhere, trending to bare compacted dirt under canopy
// and at high-traffic path edges; mid-meadow greenest.
// =====================================================================

// Ambient wear mottle — low-level patchiness across mown turf, present
// even far from paths. Rotated octaves (same family as the macro
// variation) so no axis-aligned lattice structure appears.
float turf_ambient_wear(vec2 world_xz) {
	vec2 rot = mat2(vec2(0.92, 0.39), vec2(-0.39, 0.92)) * world_xz;
	float n = vnoise(rot / 13.0 + vec2(31.7, 5.3)) * 0.65
	        + vnoise(rot / 4.7 + vec2(11.1, 47.9)) * 0.35;
	return smoothstep(0.52, 0.95, n) * 0.35;
}

// Combine wear sources: baked map (paths/benches, data-driven), ambient
// mottle, and canopy compaction — mown turf zones only. Unmown areas
// (woodland, shore, wild meadow) read brown through their own palettes
// and litter, not through lawn wear.
float turf_wear_total(float baked_wear, float canopy_cover, int zone_id, vec2 world_xz) {
	bool mown = (zone_id == 0 || zone_id == 1 || zone_id == 2 || zone_id == 3
	          || zone_id == 4 || zone_id == 6 || zone_id == 7 || zone_id == 9);
	float wear = baked_wear;
	if (mown) {
		wear = max(wear, turf_ambient_wear(world_xz));
		// Bare compacted ground under big crowns (reference hq_06-08)
		wear = max(wear, smoothstep(0.45, 0.9, canopy_cover) * 0.75);
		if (zone_id == 6) { wear = max(wear, 0.5); } // dog park: trampled
	}
	return wear;
}

// Wear → albedo. Two stages with noise-perturbed edges so path shoulders
// and patch boundaries read organic, not as smooth radial gradients:
//   wear 0.15-0.55: thinning dry turf (desaturated yellow-brown)
//   wear 0.55-0.95: bare compacted dirt
vec3 apply_turf_wear(vec3 col, float wear, vec2 world_xz) {
	if (wear <= 0.01) { return col; }
	float n = vnoise(world_xz * 0.6) * 0.7 + vnoise(world_xz * 2.3) * 0.3;
	float wn = clamp(wear * (0.65 + 0.75 * n), 0.0, 1.0);
	// Thin/dry turf: dried-grass spectral (R+T) pulled toward soil
	vec3 thin_col = vec3(0.241, 0.188, 0.103);
	col = mix(col, thin_col, smoothstep(0.15, 0.55, wn) * 0.85);
	// Compacted dirt with tonal variation
	vec3 dirt = vec3(0.150, 0.120, 0.082) * mix(0.85, 1.15, vnoise(world_xz * 1.7));
	col = mix(col, dirt, smoothstep(0.55, 0.95, wn));
	return col;
}

// Apply dead-tuft (dried/dormant) brown accents at fine scale (~1.25m
// period). Strength scales the mix amount — callers gate by season so
// summer is near-zero and autumn ramps up.
vec3 apply_dead_tufts(vec3 col, vec2 world_xz, float strength) {
	float dead_n = vnoise(world_xz * 0.8 + vec2(73.1, 29.7));
	float dead_mask = smoothstep(0.55, 0.68, dead_n);
	if (dead_mask > 0.0) {
		vec3 dead_col = vec3(0.315, 0.243, 0.120); // spectral dried grass (R+T)
		col = mix(col, dead_col, dead_mask * 0.50 * strength);
	}
	return col;
}

// Full grass base color (palette + variations + golden undertone +
// year-round dead-tuft accents). Kept for callers that don't gate by
// season; blade-coverage shaders should use grass_base_color_no_dead
// and call apply_dead_tufts with a season factor.
vec3 grass_base_color(int zone_id, vec2 world_xz) {
	vec3 col = grass_base_color_no_dead(zone_id, world_xz);
	return apply_dead_tufts(col, world_xz, 1.0);
}
