[configuration]
entry_symbol = "gpu_grass_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libgpu_grass.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgpu_grass.linux.template_release.x86_64.so"
linux.template_debug.x86_64 = "res://bin/libgpu_grass.linux.template_debug.x86_64.so"
linux.template_release.x86_64 = "res://bin/libgpu_grass.linux.template_release.x86_64.so"
