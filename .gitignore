example pics/

# Internal planning docs (not part of the project)
outreach/
discord-setup.md
open-collective-setup.md
sensory-data-sources.md
visual-reference-report.md
reference-photos.md

# Archive files
*.rar

# Blender addons/tools (install from source)
tools/

# Walk-bot debug captures (regenerated on demand)
walk_captures/
walk_debug_trees/
diag_grass*/

# Third-party Blender libraries (not redistributable)
assets/plant_library/
perf_reports/
# Ignore all of notes/ EXCEPT the one-page reference briefs + template under
# notes/refs/veg/ (bulk images/frames stay ignored). Git can't re-include a path whose
# parent dir is excluded, so each level is unwound: exclude contents (dir/*), then
# re-include the next dir down.
notes/*
!notes/refs/
notes/refs/*
!notes/refs/veg/
notes/refs/veg/*
!notes/refs/veg/*/
!notes/refs/veg/BRIEF_TEMPLATE.md
notes/refs/veg/*/*
!notes/refs/veg/*/BRIEF.md
!notes/refs/veg/*/SCHEMATIC_PROMPT.md
!notes/refs/veg/SCHEMATIC_STYLE.md
hh_NYC_029.tif
!.claude/settings.json

# Curated mound-audit verdicts + footprint mask: small, hand-classified
# (aerial-verified), and convert_to_godot.py consumes them — keep in git.
# dem_raw.bin / dsm_diff.bin sidecars stay ignored (268 MB, regenerable).
# (negations last so *.json/*.bin rules above cannot re-ignore them)
!lidar_data/lawn_mound_verdicts.json
!lidar_data/lawn_mound_mask.png
# baked octahedral tree-impostor atlases + manifest (regen: --bake-impostors)
!textures/impostors/*.png
!textures/impostors/*.json
