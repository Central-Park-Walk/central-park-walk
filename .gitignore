!models/furniture/cp_*_arch.glb
!models/vegetation/Shrub_*.glb
!models/vegetation/Fern_*.glb
!models/vegetation/Herb_*.glb
!models/vegetation/Wetland_*.glb
!models/vegetation/Grass_*.glb
!models/vegetation/Mushroom_*.gltf
!models/vegetation/ForestFloor_*.glb
textures/*
!textures/terrain3d/
!textures/impostors/
sounds/

# Terrain tiles and LiDAR source data (re-download via scripts)
terrain_tiles/
lidar_data/
*.tif

# Large data files (re-generate via download_osm.py + convert_to_godot.py)
*.json
*.bin
!project.godot
