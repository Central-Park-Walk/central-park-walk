# Godot editor cache
.godot/
*.uid

# Loose .import sidecar files at root and reference dirs
/*.import

# Reference imagery — third-party photos, not ours to redistribute. Kept on disk
# (reference_photos/<species>/ feeds the per-species modeling loop) but out of git.
/reference_photos/
/reference/*.jpg
/reference/*.jpeg
/reference/*.import
# (reference/*.md data compilations stay tracked — they're ours)

# Downloaded binary assets (re-download via scripts)
models/
!models/furniture/cp_bench.glb
!models/furniture/cp_lamppost.glb
!models/furniture/cp_trash_can.glb
!models/furniture/cp_drinking_fountain.glb
!models/furniture/cp_rocks.glb
!models/furniture/cp_*_bridge.glb
!models/furniture/cp_*_arch.glb
# Vegetation: only spicebush + cattail undergrowth stay tracked. Everything else
# in models/vegetation/ is regen-on-demand (make_*.py) and untracked. The two
# negations below keep future spicebush/cattail regens trackable; nothing else.
!models/vegetation/Shrub_Spicebush*.glb
!models/vegetation/Wetland_Cattail*.glb
# Snowflake: runtime snow-particle mesh (weather_manager.gd), not regen-on-demand.
!models/vegetation/Snowflake.glb
textures/*
!textures/terrain3d/
!textures/leaves/
# baked octahedral tree-impostor atlases (regen: --bake-impostors)
!textures/impostors/
sounds/

# Terrain tiles and LiDAR source data (re-download via scripts)
terrain_tiles/
lidar_data/*
*.tif

# Large data files (re-generate via download_osm.py + convert_to_godot.py)
*.json
*.bin
!project.godot

# Prebuilt terrain textures (re-generate via Godot editor import)
prebuilt/terrain_ctex/

# Build output and download tests
build/
linux download test/

# Mesh cache (auto-generated from GLB models, speeds up load times)
cache/

# Python cache
__pycache__/
*.pyc

# Screenshots — only the 4 README images are tracked
screenshots/
!screenshots/readme_cherry_hill_autumn.png
!screenshots/readme_ramble_summer.png
!screenshots/readme_bow_bridge_snow.png
!screenshots/readme_literary_walk_winter.png

# Presentations, reference images
*.odp
*.png
!screenshots/readme_cherry_hill_autumn.png
!screenshots/readme_ramble_summer.png
!screenshots/readme_bow_bridge_snow.png
!screenshots/readme_literary_walk_winter.png
!textures/terrain3d/*.png
example pics/

# Internal planning docs (not part of the project)
outreach/
discord-setup.md
open-collective-setup.md
sensory-data-sources.md
visual-reference-report.md
reference-photos.md
# Parked/working vision doc — self-declares uncommitted (§ status banner)
world-platform-vision.md

# Working scratch — temp renders the user watches live, plus one-off debug captures
# and superseded doc backups. Keep on disk, out of git.
tmp/
weird specific tree disappearance bug/
docs/tree work june 2026/
docs/oaks prompt.txt
docs/tree_lod_impostor_handoff_bug_brief.txt

# Archive files
*.rar

# Blender addons/tools (install from source)
tools/

# Walk-bot debug captures (regenerated on demand)
walk_captures/
walk_debug_trees/
diag_grass*/

# Third-party Blender libraries (not redistributable)
assets/plant_library/
perf_reports/
# Ignore all of notes/ EXCEPT the one-page reference briefs + template under
# notes/refs/veg/ (bulk images/frames stay ignored). Git can't re-include a path whose
# parent dir is excluded, so each level is unwound: exclude contents (dir/*), then
# re-include the next dir down.
notes/*
!notes/refs/
notes/refs/*
!notes/refs/veg/
notes/refs/veg/*
!notes/refs/veg/*/
!notes/refs/veg/BRIEF_TEMPLATE.md
notes/refs/veg/*/*
!notes/refs/veg/*/BRIEF.md
!notes/refs/veg/*/SCHEMATIC_PROMPT.md
!notes/refs/veg/SCHEMATIC_STYLE.md
hh_NYC_029.tif
!.claude/settings.json

# Curated mound-audit verdicts + footprint mask: small, hand-classified
# (aerial-verified), and convert_to_godot.py consumes them — keep in git.
# dem_raw.bin / dsm_diff.bin sidecars stay ignored (268 MB, regenerable).
# (negations last so *.json/*.bin rules above cannot re-ignore them)
!lidar_data/lawn_mound_verdicts.json
!lidar_data/lawn_mound_mask.png
# baked octahedral tree-impostor atlases + manifest (regen: --bake-impostors)
!textures/impostors/*.png
!textures/impostors/*.json
# original water ripple normal maps (regen: scripts/gen_water_normals.py)
!textures/water_normal_a.png
!textures/water_normal_b.png
# LOD-crossfade blue-noise dither tile (regen: scripts/gen_blue_noise.py). The .import
# IS tracked here (unlike other textures) because its non-default settings are load-bearing:
# detect_3d/compress_to=0 + lossless keep the exact ordered-dither bytes — a default reimport
# would recompress it lossy on first 3D use and reintroduce banding.
!textures/blue_noise_64.png
!textures/blue_noise_64.png.import
