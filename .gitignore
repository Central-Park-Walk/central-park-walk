# Godot editor cache
.godot/
*.uid

# Loose .import sidecar files at root and reference dirs
/*.import
/reference_photos/*.import

# Downloaded binary assets (re-download via scripts)
models/
!models/furniture/cp_bench.glb
!models/furniture/cp_lamppost.glb
!models/furniture/cp_trash_can.glb
!models/furniture/cp_drinking_fountain.glb
!models/furniture/cp_rocks.glb
!models/furniture/cp_*_bridge.glb
!models/furniture/cp_*_arch.glb
!models/vegetation/Snowflake.glb
!models/vegetation/Flower_*.glb
!models/vegetation/Tuft_Tiny.glb
!models/vegetation/Tuft_Woodland.glb
!models/vegetation/Tuft_Wild.glb
!models/vegetation/Tuft_Meadow.glb
!models/vegetation/cp_vines.glb
textures/*
!textures/terrain3d/
sounds/

# Terrain tiles and LiDAR source data (re-download via scripts)
terrain_tiles/
lidar_data/
*.tif

# Large data files (re-generate via download_osm.py + convert_to_godot.py)
*.json
*.bin
!project.godot

# Prebuilt terrain textures (re-generate via Godot editor import)
prebuilt/terrain_ctex/

# Build output and download tests
build/
linux download test/

# Mesh cache (auto-generated from GLB models, speeds up load times)
cache/

# Python cache
__pycache__/
*.pyc

# Screenshots — only the 4 README images are tracked
screenshots/
!screenshots/readme_cherry_hill_autumn.png
!screenshots/readme_ramble_summer.png
!screenshots/readme_bow_bridge_snow.png
!screenshots/readme_literary_walk_winter.png

